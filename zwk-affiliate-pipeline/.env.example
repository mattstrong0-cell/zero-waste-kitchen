# ─── Firecrawl ────────────────────────────────────────────────────────────────
# Get your key at https://firecrawl.dev
# Free tier: 500 credits. Each scrape = 1 credit; LLM extraction = ~2-3 credits.
FIRECRAWL_API_KEY=fc-your-key-here

# ─── Instagram ────────────────────────────────────────────────────────────────
# Instagram blocks public hashtag access. You must provide a session cookie.
# How to get it:
#   1. Log into instagram.com in Chrome/Firefox
#   2. Open DevTools → Application → Cookies → https://www.instagram.com
#   3. Copy the value of the "sessionid" cookie
# Cookies expire every ~90 days — refresh when scraper returns 0 results.
INSTAGRAM_SESSION_ID=your-sessionid-cookie-value

# ─── Pinterest ────────────────────────────────────────────────────────────────
# Requires a Pinterest Business account + Developer app.
# Steps:
#   1. Create a Business account at pinterest.com/business/create
#   2. Go to https://developers.pinterest.com/apps/ → Create app
#   3. Request scopes: boards:read, pins:read
#   4. Generate an access token (OAuth2 or long-lived token from app dashboard)
PINTEREST_ACCESS_TOKEN=your-access-token-here

# ─── Scraper settings ─────────────────────────────────────────────────────────
# Max items to collect per hashtag/keyword per run (default: 25)
SCRAPE_LIMIT=25
